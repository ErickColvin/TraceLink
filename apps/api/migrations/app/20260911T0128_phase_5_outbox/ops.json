    "id": "table.outbox_events",
    "label": "Create table \"outbox_events\"",
    "summary": "Creates table \"outbox_events\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "outbox_events"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"outbox_events\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"outbox_events\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"outbox_events\"",
        "sql": "CREATE TABLE \"public\".\"outbox_events\" (\n  \"attempts\" int4 DEFAULT 0 NOT NULL,\n  \"created_at\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"delivered_at\" timestamptz(3),\n  \"event_key\" character varying(200) NOT NULL,\n  \"event_type\" character varying(120) NOT NULL,\n  \"id\" uuid DEFAULT (gen_random_uuid()) NOT NULL,\n  \"last_error\" character varying(1000),\n  \"locked_at\" timestamptz(3),\n  \"max_attempts\" int4 DEFAULT 5 NOT NULL,\n  \"next_attempt_at\" timestamptz(3) DEFAULT (now()) NOT NULL,\n  \"organization_id\" uuid NOT NULL,\n  \"payload\" json NOT NULL,\n  \"provider_message_id\" character varying(200),\n  \"recipient_email\" character varying(320) NOT NULL,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"outbox_event_state_valid_566c2672\" CHECK (char_length(btrim(\"event_key\")) > 0 AND char_length(btrim(\"event_type\")) > 0 AND char_length(btrim(\"recipient_email\")) > 0 AND \"attempts\" >= 0 AND \"max_attempts\" BETWEEN 1 AND 20 AND \"attempts\" <= \"max_attempts\" AND ((\"status\" = 'PENDING' AND \"locked_at\" IS NULL AND \"delivered_at\" IS NULL) OR (\"status\" = 'PROCESSING' AND \"locked_at\" IS NOT NULL AND \"delivered_at\" IS NULL) OR (\"status\" = 'DELIVERED' AND \"locked_at\" IS NULL AND \"delivered_at\" IS NOT NULL) OR (\"status\" = 'DEAD' AND \"locked_at\" IS NULL AND \"delivered_at\" IS NULL))),\n  CONSTRAINT \"outbox_events_status_check_8211561f\" CHECK (\"status\" IN ('PENDING', 'PROCESSING', 'DELIVERED', 'DEAD'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"outbox_events\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"outbox_events\""
        ]
      }
    ]
  },
