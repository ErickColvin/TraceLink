{
  "name": "tracelink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tracelink/api --filter @tracelink/web dev",
    "dev:web": "pnpm --filter @tracelink/web dev",
    "dev:api": "pnpm --filter @tracelink/api dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @tracelink/api test:unit",
    "test:integration": "pnpm --filter @tracelink/api test:integration",
    "test:api": "pnpm --filter @tracelink/api test:api",
    "test:e2e": "pnpm --filter @tracelink/api test:e2e",
    "test:watch": "pnpm --filter @tracelink/web test:watch",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:test:up": "docker compose --profile test up -d db-test",
    "db:contract": "pnpm --filter @tracelink/api db:contract",
    "db:plan": "pnpm --filter @tracelink/api db:plan",
    "db:migrate": "pnpm --filter @tracelink/api db:migrate",
    "db:verify": "pnpm --filter @tracelink/api db:verify",
    "db:migration:check": "pnpm --filter @tracelink/api db:migration:check",
    "db:seed": "pnpm --filter @tracelink/api db:seed",
    "reservations:expire": "pnpm --filter @tracelink/api reservations:expire",
    "payments:reconcile": "pnpm --filter @tracelink/api payments:reconcile",
    "outbox:process": "pnpm --filter @tracelink/api outbox:process",
    "production:bootstrap": "pnpm --filter @tracelink/api production:bootstrap",
    "preview": "pnpm --filter @tracelink/web preview",
    "review:visual": "node tools/visual-review.mjs"
  },
  "devDependencies": {
    "@railway/cli": "5.52.0",
    "playwright-core": "^1.62.1",
    "pnpm": "11.24.0",
    "railway": "3.11.0"
  }
}
