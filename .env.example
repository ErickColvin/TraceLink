# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=false

# PostgreSQL 18 local container
POSTGRES_DB=tracelink
POSTGRES_USER=tracelink
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tracelink:replace-with-a-local-only-password@127.0.0.1:5432/tracelink?schema=public

# Integration database (`pnpm db:test:up`). Never point this at production.
POSTGRES_TEST_DB=tracelink_test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql://tracelink:replace-with-a-local-only-password@127.0.0.1:5433/tracelink_test?schema=public

# Browser boundary
WEB_ORIGIN=http://127.0.0.1:5173
ORGANIZATION_SLUG=ch-market
SESSION_TTL_SECONDS=86400
SESSION_IDLE_TTL_SECONDS=1800

# Generate independent random values of at least 32 bytes for every secret.
# Do not copy these placeholders into a deployed environment.
SESSION_SECRET=replace-with-base64-session-secret-at-least-32-bytes
CSRF_SECRET=replace-with-base64-csrf-secret-at-least-32-bytes
IDEMPOTENCY_SECRET=replace-with-base64-idempotency-secret-at-least-32-bytes
RATE_LIMIT_SECRET=replace-with-base64-rate-limit-secret-at-least-32-bytes
PICKUP_CODE_SECRET=replace-with-base64-pickup-code-secret-at-least-32-bytes

# Payments. Keep real credentials only in the local environment/secret manager.
PAYMENT_PROVIDER=fake
MERCADOPAGO_ACCESS_TOKEN=replace-with-mercadopago-access-token
MERCADOPAGO_WEBHOOK_SECRET=replace-with-mercadopago-webhook-secret
PAYMENT_SUCCESS_URL=http://127.0.0.1:5173/checkout/resultado
PAYMENT_FAILURE_URL=http://127.0.0.1:5173/checkout/resultado
PAYMENT_PENDING_URL=http://127.0.0.1:5173/checkout/resultado
PAYMENT_WEBHOOK_URL=http://127.0.0.1:3001/api/v1/webhooks/mercadopago
CHECKOUT_RESERVATION_MINUTES=15

# Development seed identity. Set local values before running the seed command.
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-before-seeding
SEED_STAFF_EMAIL=staff@example.invalid
SEED_STAFF_PASSWORD=replace-before-seeding
SEED_CUSTOMER_EMAIL=customer@example.invalid
SEED_CUSTOMER_PASSWORD=replace-before-seeding
SEED_PACKAGE_PICKUP_CODE=replace-before-seeding

# Frontend HTTP composition root
VITE_DATA_MODE=http
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
